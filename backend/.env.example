# Leave blank to run the demo with sign-in and permission guards switched off.
ENTRA_CLIENT_ID=
# Required once a client ID is set. Use your tenant GUID, not common/organisations.
ENTRA_TENANT_ID=
# Optional separate API registration. Defaults to ENTRA_CLIENT_ID.
ENTRA_API_CLIENT_ID=
# Expose this delegated scope on the API registration.
ENTRA_SCOPE=access_as_user
